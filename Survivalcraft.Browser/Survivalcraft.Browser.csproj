<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <RootNamespace>Game</RootNamespace>
        <AssemblyName>Survivalcraft</AssemblyName>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
        <ApplicationVersion>2.4.0.0</ApplicationVersion>
        <AssemblyVersion>2.4.0.0</AssemblyVersion>
        <FileVersion>2.4.0.0</FileVersion>
        <LangVersion>preview</LangVersion>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>disable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <OutputType>Exe</OutputType>
        <IsAotCompatible>true</IsAotCompatible>
        <InvariantGlobalization>false</InvariantGlobalization>
        <EmccFlags>-s FULL_ES3=1 -lopenal -lGL -s USE_PTHREADS=1 -s OFFSCREENCANVAS_SUPPORT=1 -s OFFSCREENCANVASES_TO_PTHREAD=#canvas -s OFFSCREEN_FRAMEBUFFER=1</EmccFlags>
        <WasmMainJSPath>wwwroot\main.js</WasmMainJSPath>
    </PropertyGroup>
    <PropertyGroup>
        <PublishTrimmed>true</PublishTrimmed>
        <WasmBuildNative>true</WasmBuildNative>
        <RunAOTCompilation>true</RunAOTCompilation>
        <WasmEnableThreads>true</WasmEnableThreads><!--TODO-->
        <WasmEnableSIMD>true</WasmEnableSIMD>
        <!-- Normal,JustInterp,Full,FullInterp,Hybrid,LLVMOnly,LLVMOnlyInterp -->
        <!-- <AOTMode>LLVMOnly</AOTMode> -->
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Browser' ">
        <DefineConstants>DEBUG;BROWSER</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Engine\Engine.csproj" SetTargetFramework="TargetFramework=net10.0" />
        <ProjectReference Include="..\EntitySystem\EntitySystem.csproj" SetTargetFramework="TargetFramework=net10.0" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="NuGet.Versioning" Version="7.0.1" />
        <PackageReference Include="NAudio.Flac.Unknown.Mod" Version="1.0.4" />
    </ItemGroup>
    <ItemGroup>
        <NativeFileReference Include="Native/libEGL.c" ScanForPInvokes="true" />
        <NativeFileReference Include="Native/openal32.c" ScanForPInvokes="true" />
        <NativeFileReference Include="Native/emscripten.c" ScanForPInvokes="true" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="..\Survivalcraft.Windows\Content.zip" Link="Content.zip" />
    </ItemGroup>
    <ItemGroup>
        <WasmExtraFilesToDeploy Include="$(MSBuildThisFileDirectory)wwwroot\**" TargetPath="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="..\Survivalcraft.Windows\**\*.cs" Exclude="..\Survivalcraft.Windows\obj\**\*.cs"/>
    </ItemGroup>
</Project>
