{
  "template": "Humanoid",
  "animations": {
    "Idle": {
      "source": "animation://Idle",
      "loop": true
    },
    "Walk": {
      "source": "animation://Walk",
      "loop": true,
      "speed": 1.0
    },
    "Run": {
      "source": "animation://Run",
      "loop": true,
      "speed": 1.3
    },
    "Jump": {
      "source": "animation://Jump",
      "loop": false,
      "speed": 1.0
    },
    "Swim": {
      "source": "animation://Swim",
      "loop": true,
      "speed": 0.9
    },
    "Death": {
      "source": "animation://Death",
      "loop": false,
      "speed": 1.0
    }
  },
  "stateRules": [
    {
      "trackName": "Movement",
      "rules": [
        { "condition": "IsDead", "targetState": "Death" },
        { "condition": "IsInWater && Speed > 0.1", "targetState": "Swim" },
        { "condition": "IsJumping", "targetState": "Jump" },
        { "condition": "Speed > 3", "targetState": "Run" },
        { "condition": "Speed > 0.1", "targetState": "Walk" },
        { "condition": "true", "targetState": "Idle" }
      ]
    }
  ],
  "drivers": [
    {
      "type": "LookAtDriver",
      "layer": "Additive",
      "headBone": "Head",
      "targetParameter": "LookAtTarget",
      "weightParameter": "LookAtWeight",
      "maxAngle": 45.0
    }
  ],
  "parameters": {
    "Speed": 0,
    "IsDead": false,
    "IsInWater": false,
    "IsJumping": false,
    "LookAtWeight": 1.0
  }
}
