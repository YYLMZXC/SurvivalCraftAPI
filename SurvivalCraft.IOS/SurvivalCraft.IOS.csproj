<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-ios18.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <!--
      Enable full trimming in Release mode.
      To learn more, see: https://learn.microsoft.com/dotnet/core/deploying/trimming/trimming-options#trimming-granularity
    -->
    <TrimMode Condition="'$(Configuration)' == 'Release'">full</TrimMode>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <AssemblyName>Survivalcraft</AssemblyName>
    <ProvisioningType>manual</ProvisioningType>
      <EnableSGenConc>True</EnableSGenConc>
      <ApplicationId>com</ApplicationId>
      <SupportedOSPlatformVersion>16.0</SupportedOSPlatformVersion>
    </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <MtouchLink>SdkOnly</MtouchLink>
  </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <MtouchLink>SdkOnly</MtouchLink>
    </PropertyGroup>
    <ItemGroup>
    <Compile Include="..\Survivalcraft.Windows\**\*.cs" Exclude="..\Survivalcraft.Windows\obj\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="..\Survivalcraft.Windows\Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\Survivalcraft.Windows\Content.zip" Link="Content.zip">
      <LogicalName>Game.Content.zip</LogicalName>
    </EmbeddedResource>
    <None Include="..\Survivalcraft.Windows\init.js" Link="init.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Engine\Engine.csproj" />
    <ProjectReference Include="..\EntitySystem\EntitySystem.csproj" />
  </ItemGroup>
</Project>