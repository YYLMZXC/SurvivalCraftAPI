{
  "template": "Simple",
  "animations": {
    "Idle": {
      "source": "animation://Idle",
      "loop": true
    },
    "Fly": {
      "source": "animation://Fly",
      "loop": true,
      "speed": 1.0
    },
    "Glide": {
      "source": "animation://Glide",
      "loop": true,
      "speed": 0.8
    },
    "Death": {
      "source": "animation://Death",
      "loop": false,
      "speed": 1.0
    }
  },
  "stateRules": [
    {
      "trackName": "Movement",
      "rules": [
        { "condition": "IsDead", "targetState": "Death" },
        { "condition": "IsFlying && Speed > 1", "targetState": "Fly" },
        { "condition": "IsFlying", "targetState": "Glide" },
        { "condition": "true", "targetState": "Idle" }
      ]
    }
  ],
  "parameters": {
    "Speed": 0,
    "IsDead": false,
    "IsFlying": false
  }
}
